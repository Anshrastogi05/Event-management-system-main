# Backend env template
# Use the Render block for production and the Local block as your laptop reference.

# ----------------------------
# Render / production
# ----------------------------
NODE_ENV=production
PORT=5050
MONGO_URI=mongodb+srv://your-user:your-password@your-cluster.mongodb.net/your-db
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

CLIENT_URL=https://your-frontend.vercel.app
CLIENT_URLS=https://your-frontend.vercel.app,https://*.vercel.app

AUTH_OTP_EXPIRES_IN_MINUTES=5
AUTH_OTP_MAX_ATTEMPTS=5
AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
TICKET_HOLD_MINUTES=8

# Brevo SMTP
# SMTP_USER is your Brevo SMTP login.
# SMTP_PASS is your Brevo SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
EMAIL_FROM=Campus Events <verified-email@example.com>

# Optional mail timeout in milliseconds.
EMAIL_DELIVERY_TIMEOUT_MS=15000

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Use a separate webhook secret if Razorpay dashboard provides one.
RAZORPAY_WEBHOOK_SECRET=

# Render Redis example:
# Use the Redis URL from your Render Redis instance.
# REDIS_URL=redis://your-render-redis-url:6379
# If you prefer host/port fields, keep them consistent with the same Redis instance.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=event-manager

# ----------------------------
# Local development
# ----------------------------
# NODE_ENV=development
# PORT=5050
# MONGO_URI=mongodb://127.0.0.1:27017/event_mgmt
# JWT_SECRET=replace-with-another-long-secret
# JWT_EXPIRES_IN=7d
# CLIENT_URL=http://localhost:5173
# CLIENT_URLS=http://localhost:5173
# AUTH_OTP_EXPIRES_IN_MINUTES=5
# AUTH_OTP_MAX_ATTEMPTS=5
# AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# PASSWORD_RESET_TOKEN_TTL_MINUTES=30
# TICKET_HOLD_MINUTES=8
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=your-brevo-smtp-login
# SMTP_PASS=your-brevo-smtp-key
# EMAIL_FROM=Campus Events <verified-email@example.com>
# EMAIL_DELIVERY_TIMEOUT_MS=15000
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_URL=redis://127.0.0.1:6379/0
# REDIS_PASSWORD=
